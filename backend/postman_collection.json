{
  "info": {
    "name": "EventBook API",
    "description": "Mini Event Booking System API.\n\nImport the fresh seed data first (backend/database/schema.sql), then run the whole collection in order (Collection Runner). Every request checks its expected status and message. IDs are captured from earlier responses, so nothing is hard-coded.\n\n'Upload cover image' needs a file: choose one in the Body tab when running it manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('message', () => pm.expect(body.message).to.eql(\"Events retrieved.\"));",
                  "pm.test('has events with slot info', () => {",
                  "  pm.expect(body.data.length).to.be.above(0);",
                  "  pm.expect(body.data[0]).to.include.keys('title', 'event_date', 'available_slots', 'is_full');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?date=2026-12-10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-12-10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('only that date', () => body.data.forEach(e => pm.expect(e.event_date).to.match(/^2026-12-10/)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search + category + sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?search=seminar&category=Seminar&sort=upcoming",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "seminar"
                },
                {
                  "key": "category",
                  "value": "Seminar"
                },
                {
                  "key": "sort",
                  "value": "upcoming"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('only Seminar', () => body.data.forEach(e => pm.expect(e.category).to.eql('Seminar')));"
                ]
              }
            }
          ]
        },
