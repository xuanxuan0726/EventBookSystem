                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('message', () => pm.expect(body.message).to.eql(\"Event created successfully.\"));",
                  "pm.collectionVariables.set('eventId', body.data.id);"
                ]
              }
            }
          ]
        },
